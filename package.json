{
  "name": "events-halls-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Wedding and event halls booking platform with vendor dashboard",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3108",
    "build": "prisma generate && next build",
    "start": "next start -p 3108",
    "test": "vitest run",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
